# Copy to .env and fill in ONE model provider. Never commit .env.

# --- Local mock vendor-risk service ----------------------------------------------------------
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# --- Model provider (any OpenAI-compatible chat-completions endpoint) ------------------------
# Option 1 - Groq (free tier; key from https://console.groq.com/keys)
GROQ_API_KEY=
# MODEL_NAME=openai/gpt-oss-120b      # default for Groq; openai/gpt-oss-20b is the smaller model

# Option 2 - Google Gemini (key from https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# MODEL_NAME=gemini-3.8-flash

# Option 3 - anything else that speaks the OpenAI chat-completions API
# LLM_BASE_URL=
# LLM_API_KEY=
# MODEL_NAME=

# --- Optional tuning -------------------------------------------------------------------------
# LLM_PROVIDER=groq                    # force a provider when several keys are set
# LLM_REASONING_EFFORT=low             # sent only if set (defaults to low for gpt-oss models)
# LLM_MAX_RATE_LIMIT_WAIT_SECONDS=75   # longest the client will wait for per-minute quota
# VENDOR_RISK_TIMEOUT_SECONDS=3
